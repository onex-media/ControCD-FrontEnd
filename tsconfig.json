{
  "extends": "@quasar/app-vite/tsconfig-preset",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["vue", "vite/client"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "exclude": [
    "./dist",
